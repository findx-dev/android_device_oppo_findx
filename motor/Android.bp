aidl_interface {
    name: "vendor.oplus.hardware.motor",
    owner: "lineage",
    vendor_available: true,
    local_include_dir: "aidl",
    srcs: [
        "aidl/vendor/oplus/hardware/motor/*.aidl",
    ],
    stability: "vintf",
    backend: {
        cpp: {
            enabled: false,
        },
        java: {
            enabled: true,
            sdk_version: "system_current",
        },
        ndk: {
            enabled: true,
        },
    },
    versions_with_info: [
        {
            version: "1",
            imports: [],
        },
    ],
    frozen: true,
}

cc_binary {
    name: "vendor.oplus.hardware.motor-service.findx",
    srcs: [
        "hal/Motor.cpp",
        "hal/service.cpp",
    ],
    local_include_dirs: ["hal"],
    init_rc: ["hal/vendor.oplus.hardware.motor-service.findx.rc"],
    vintf_fragments: ["hal/vendor.oplus.hardware.motor-service.findx.xml"],
    relative_install_path: "hw",
    shared_libs: [
        "libbase",
        "libbinder",
        "libbinder_ndk",
        "liblog",
        "libutils",
    ],
    static_libs: [
        "vendor.oplus.hardware.motor-V1-ndk",
    ],
    cflags: [
        "-Wall",
        "-Werror",
        "-Wextra",
        "-Wthread-safety",
    ],
    vendor: true,
}

android_app {
    name: "FindXCameraHelper",
    srcs: ["helper/src/**/*.kt"],
    static_libs: [
        "vendor.oplus.hardware.motor-V1-java",
    ],
    manifest: "helper/AndroidManifest.xml",
    resource_dirs: ["helper/res"],
    platform_apis: true,
    certificate: "platform",
    privileged: true,
    system_ext_specific: true,
    optimize: {
        proguard_flags_files: ["helper/proguard.flags"],
    },
}
